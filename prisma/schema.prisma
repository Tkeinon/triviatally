// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SessionStatus {
  UPCOMING
  ONGOING
  COMPLETED
}

model Team {
  id          String    @id @default(cuid())
  name        String    @unique
  members     User[]
  hostedSessions GameSession[] @relation("HostTeam")
  scores      Score[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Hashed, optional for OAuth
  isAdmin       Boolean   @default(false)
  teamId        String?
  team          Team?     @relation(fields: [teamId], references: [id])
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@id([provider, providerAccountId])
}
 
model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
 
model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@id([identifier, token])
}

model Season {
  id            String    @id @default(cuid())
  name          String
  isActive      Boolean   @default(true)
  sessionsPerTeam Int     @default(1)
  sessions      GameSession[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
}

model GameSession {
  id          String        @id @default(cuid())
  seasonId    String?
  season      Season?       @relation(fields: [seasonId], references: [id])
  hostTeamId  String
  hostTeam    Team          @relation("HostTeam", fields: [hostTeamId], references: [id])
  status      SessionStatus @default(UPCOMING)
  date        DateTime?
  currentRound Int          @default(1)
  rounds      Round[]
  scores      Score[]
}

model Round {
  id          String   @id @default(cuid())
  sessionId   String
  session     GameSession  @relation(fields: [sessionId], references: [id])
  order       Int      // e.g., 1, 2, 3
  isSuper     Boolean  @default(false)
  pointsPerQ  Int      @default(1)
  penaltyPerQ Int      @default(0)     // For Super Knowledge rounds
  scores      Score[]
}

model Score {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  roundId   String
  round     Round    @relation(fields: [roundId], references: [id])
  sessionId String
  session   GameSession  @relation(fields: [sessionId], references: [id])
  points    Int      @default(0)
}